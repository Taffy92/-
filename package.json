{
  "name": "doctool-platform",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev:web": "node scripts/run-pnpm.cjs --filter web dev",
    "build:web": "node scripts/run-pnpm.cjs --filter web build",
    "export:web": "node scripts/run-pnpm.cjs --filter web build",
    "sync:security": "node scripts/run-pnpm.cjs --filter web sync:security",
    "deploy:vercel": "vercel --prod",
    "deploy:cloudbase": "tcb hosting deploy apps/web/out -e format-converter-prod-x-d71bce41",
    "deploy:license-admin": "cd cloudbase/functions/licenseAdmin && echo. | tcb fn deploy licenseAdmin --dir . --httpFn --force -e format-converter-prod-x-d71bce41",
    "build:desktop": "node scripts/run-pnpm.cjs --filter desktop build",
    "package:desktop": "node scripts/run-pnpm.cjs --filter desktop package",
    "check:privacy": "node scripts/run-pnpm.cjs --filter web check:privacy",
    "check:network": "node scripts/run-pnpm.cjs --filter web check:network",
    "generate:notices": "node scripts/generate-third-party-notices.mjs",
    "test": "node scripts/run-pnpm.cjs --filter web test"
  },
  "pnpm": {
    "overrides": {
      "postcss": "8.5.10",
      "uuid": "11.1.1"
    }
  },
  "devDependencies": {
    "@cloudbase/cli": "^3.3.3",
    "@types/node": "^20.12.12",
    "typescript": "^5.4.5",
    "vercel": "^34.2.0"
  }
}
