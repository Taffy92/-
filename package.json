{
  "name": "doctool-platform",
  "version": "2.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": "20.x",
    "pnpm": "9.15.4"
  },
  "scripts": {
    "dev:web": "node scripts/run-pnpm.cjs --filter web dev",
    "build:web": "node scripts/run-pnpm.cjs --filter web build",
    "build:edgeone": "node scripts/run-pnpm.cjs --filter web build:edgeone",
    "export:web": "node scripts/run-pnpm.cjs --filter web build",
    "sync:security": "node scripts/run-pnpm.cjs --filter web sync:security",
    "deploy:vercel": "vercel --prod",
    "deploy:edgeone": "edgeone makers deploy apps/web/out -n format-converter-web-upload -e production",
    "deploy:cloudbase": "tcb hosting deploy apps/web/out -e format-converter-prod-x-d71bce41",
    "deploy:license-admin": "npm run build:edgeone && npm run deploy:edgeone",
    "build:desktop": "node scripts/run-pnpm.cjs --filter desktop build",
    "package:desktop": "node scripts/run-pnpm.cjs --filter desktop package",
    "package:desktop:msi": "node scripts/run-pnpm.cjs --filter desktop package:msi",
    "prepare:libreoffice": "node scripts/prepare-libreoffice.mjs",
    "package:desktop:all": "node scripts/run-pnpm.cjs --filter desktop build:all",
    "check:privacy": "node scripts/run-pnpm.cjs --filter web check:privacy",
    "check:network": "node scripts/run-pnpm.cjs --filter web check:network",
    "generate:notices": "node scripts/generate-third-party-notices.mjs",
    "test": "node scripts/run-pnpm.cjs --filter web test"
  },
  "pnpm": {
    "overrides": {
      "postcss": "8.5.26",
      "sharp": "0.35.3",
      "tmp": "0.2.7",
      "brace-expansion@1.1.14": "1.1.18",
      "brace-expansion@2.1.0": "2.1.4",
      "uuid": "11.1.1"
    }
  },
  "dependencies": {
    "@edgeone/pages-blob": "0.0.14"
  },
  "devDependencies": {
    "@cloudbase/cli": "^3.3.3",
    "@types/node": "^20.12.12",
    "typescript": "^5.4.5",
    "vercel": "^34.2.0"
  }
}
